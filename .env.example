# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# Resend (contact form emails) — get one at https://resend.com/api-keys
RESEND_API_KEY=

# Destination address
CONTACT_TO_EMAIL=hello@samanrizvi.com

# Sender address — must be a domain verified in Resend.
# For production, verify samanrizvi.com and use hello@samanrizvi.com.
CONTACT_FROM_EMAIL=Saman Portfolio <onboarding@resend.dev>

# Local dev: point the form at the dev API server
# (run: node scripts/dev-api.mjs)
VITE_CONTACT_ENDPOINT=http://localhost:3004/contact
